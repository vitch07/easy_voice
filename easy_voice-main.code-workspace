{
    "folders": [
        {
            "path": "easy_voice-main",
            "name": "Easy Voice - Flutter Project"
        }
    ],
    "settings": {
        "dart.flutterSdkPath": null,
        "files.exclude": {
            "**/.git": true,
            "**/.svn": true,
            "**/.hg": true,
            "**/CVS": true,
            "**/.DS_Store": true,
            "**/Thumbs.db": true,
            "**/build": false
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/bower_components": true,
            "**/*.code-search": true,
            "**/build": true,
            "**/.dart_tool": true
        },
        "java.configuration.updateBuildConfiguration": "interactive"
    },
    "extensions": {
        "recommendations": [
            "dart-code.dart-code",
            "dart-code.flutter"
        ]
    }
}

